# PostgreSQL + PostGIS
DB_HOST=localhost
DB_PORT=5432
DB_NAME=meetup
DB_USER=meetup
DB_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# 실시간 전파 (redis: 인스턴스 간 Pub/Sub, local: 단일 인스턴스)
REALTIME_BROADCAST=redis

# 앱 포트 (compose 외부 노출)
APP_PORT=8080
APP2_PORT=8081

# 카카오 (지도 JS SDK · 로컬 지오코딩)
KAKAO_JS_KEY=
KAKAO_REST_KEY=

# 서울 열린데이터광장 (역사마스터 정보, 기준역 적재 전용)
SEOUL_OPENAPI_KEY=

# 대중교통 경로 (사전 적재 전용, 런타임 미사용)
ODSAY_API_KEY=

# 적재 (docs/loader.md). graph: 지하철 그래프 계산, odsay: ODsay 호출
LOADER_MODE=graph
STATIONS_CSV=
LOADER_DAILY_LIMIT=0
# ODsay 무료 한도 (월). DB 장부(api_call_budget)로 실행이 달라도 합산
ODSAY_MONTHLY_LIMIT=30
